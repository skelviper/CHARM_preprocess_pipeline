BWA_MAP_THREADS = max(
    config["resources"]["bwa_cpu_threads"] + config["resources"]["bwa_map_sort_threads"],
    config["resources"]["bwa_map_index_threads"],
)
ALIGN2PAIRS_TMP_ROOT = config["resources"].get("align2pairs_tmp_root", "")
ALIGN2PAIRS_CONTACT_MIN_MAPQ = 20
ALIGN2PAIRS_SEX_MIN_MAPQ = 30
ALIGN2PAIRS_NO_XY_FALLBACK = str(config.get("sex_no_xy_fallback", "XX")).upper()

rule bwa_map:
    input:
        ref_genome=config["refs"][config["ref_genome"]]["bwa_mem2_index"],
        DNA1="processed/{sample}/DNA/{sample}.dna.clean.R1.fq.gz",
        DNA2="processed/{sample}/DNA/{sample}.dna.clean.R2.fq.gz",
    output:
        bam = "processed/{sample}/mapping/{sample}.sort.bam",
        bamidx = "processed/{sample}/mapping/{sample}.sort.bam.bai"
    threads: BWA_MAP_THREADS
    params:
        extra=r"-R '@RG\tID:{sample}\tPL:ILLUMINA\tSM:{sample}'",
        bwa_threads=config["resources"]["bwa_cpu_threads"],
        sort_threads=config["resources"]["bwa_map_sort_threads"],
        index_threads=config["resources"]["bwa_map_index_threads"],
    shell:"""
        set -euo pipefail
        bwa-mem2 mem -5SP -t{params.bwa_threads} {params.extra} \
          {input.ref_genome} {input.DNA1} {input.DNA2} | \
          samtools sort -@{params.sort_threads} -o {output.bam} -
        samtools index -@{params.index_threads} {output.bam} {output.bamidx}
        """

rule align2pairs:
    input:
        snp_file = config["refs"][config["ref_genome"]]["snp"],
        par_file = config["refs"][config["ref_genome"]]["par"],
        bam = rules.bwa_map.output.bam,
        output_utils = os.path.join(SCRIPTS_DIR, "output_utils.sh"),
        classifier = os.path.join(SCRIPTS_DIR, "classify_2d_bam.py"),
    output:
        contacts_seg = "processed/{sample}/2d_info/contacts.seg.gz",
    params:
        yperx_threshold = config["yperx_threshold"],
        if_snp = config["if_snp"],
        if_ht = config["if_ht"],
        tmp_root = ALIGN2PAIRS_TMP_ROOT,
        contact_min_mapq = ALIGN2PAIRS_CONTACT_MIN_MAPQ,
        sex_min_mapq = ALIGN2PAIRS_SEX_MIN_MAPQ,
        no_xy_fallback = ALIGN2PAIRS_NO_XY_FALLBACK,
    log:
        contacts_seg_log = "processed/{sample}/2d_info/contacts.seg.log",
        yperx = "processed/{sample}/2d_info/{sample}.yperx.txt",
        sex_classification = "processed/{sample}/2d_info/{sample}.sex_classification.tsv",
    threads: config["resources"]["align2pairs_cpu_threads"],
    resources:
        mem_mb = config["resources"]["align2pairs_mem_mb"],

    shell: """
        set -euo pipefail
        source {input.output_utils}

        export PATH={SCRIPTS_DIR}:$PATH
        if_snp={params.if_snp}
        if_ht={params.if_ht}
        classification=$(python {input.classifier} \
          --bam {input.bam} \
          --classification-output {log.sex_classification} \
          --yperx-output {log.yperx} \
          --contact-min-mapq {params.contact_min_mapq} \
          --sex-min-mapq {params.sex_min_mapq} \
          --yperx-threshold "{params.yperx_threshold}" \
          --no-xy-fallback "{params.no_xy_fallback}")
        IFS='|' read -r input_state sex_state sex_call qualifying_records \
          <<< "$classification"

        if (( qualifying_records == 0 )); then
            printf 'biological_empty\t%s\n' "$input_state" > {log.contacts_seg_log}
            charm_make_empty_seg_from_bam {input.bam} {output.contacts_seg}
        else
            configured_tmp_root="{params.tmp_root}"
            if [ -n "$configured_tmp_root" ]; then
                tmp_root="$configured_tmp_root"
            elif [ -n "${{TMPDIR:-}}" ]; then
                tmp_root="$TMPDIR"
            else
                tmp_root="processed/{wildcards.sample}/2d_info/tmp"
            fi
            mkdir -p "$tmp_root"

            name_sort_bam() (
                set -euo pipefail
                sort_tmp=$(mktemp -d "$tmp_root/{wildcards.sample}.align2pairs.XXXXXX")
                trap 'rm -rf -- "$sort_tmp"' EXIT
                trap 'exit 129' HUP
                trap 'exit 130' INT
                trap 'exit 143' TERM
                samtools sort -n --no-PG -O SAM -@{threads} \
                  -T "$sort_tmp/namesort" {input.bam}
            )

            if [ "$if_snp" = "True" ]; then
                if [ "$sex_call" = "XY" ]; then
                    name_sort_bam | \
                      {SCRIPTS_DIR}/hickit.js sam2seg \
                        -q {params.contact_min_mapq} -v {input.snp_file} - \
                        2> {log.contacts_seg_log} | \
                      {SCRIPTS_DIR}/hickit.js chronly - | \
                      {SCRIPTS_DIR}/hickit.js bedflt {input.par_file} - | \
                      (if [ "$if_ht" = "False" ]; then sed 's/-/+/g'; else cat; fi) | \
                      gzip > {output.contacts_seg}
                else
                    name_sort_bam | \
                      {SCRIPTS_DIR}/hickit.js sam2seg \
                        -q {params.contact_min_mapq} -v {input.snp_file} - \
                        2> {log.contacts_seg_log} | \
                      {SCRIPTS_DIR}/hickit.js chronly -y - | \
                      (if [ "$if_ht" = "False" ]; then sed 's/-/+/g'; else cat; fi) | \
                      gzip > {output.contacts_seg}
                fi
            else
                if [ "$sex_call" = "XY" ]; then
                    name_sort_bam | \
                      {SCRIPTS_DIR}/hickit.js sam2seg \
                        -q {params.contact_min_mapq} - \
                        2> {log.contacts_seg_log} | \
                      {SCRIPTS_DIR}/hickit.js chronly - | \
                      (if [ "$if_ht" = "False" ]; then sed 's/-/+/g'; else cat; fi) | \
                      gzip > {output.contacts_seg}
                else
                    name_sort_bam | \
                      {SCRIPTS_DIR}/hickit.js sam2seg \
                        -q {params.contact_min_mapq} - \
                        2> {log.contacts_seg_log} | \
                      {SCRIPTS_DIR}/hickit.js chronly -y - | \
                      (if [ "$if_ht" = "False" ]; then sed 's/-/+/g'; else cat; fi) | \
                      gzip > {output.contacts_seg}
                fi
            fi
        fi

    """

rule seg2pairs:
    input:
        contacts_seg = rules.align2pairs.output.contacts_seg,
        output_utils = os.path.join(SCRIPTS_DIR, "output_utils.sh"),
    output:
        raw_pairs = "processed/{sample}/2d_info/raw.pairs.gz",
        contacts_pairs = "processed/{sample}/2d_info/contacts.pairs.gz",
    params:
        if_ht = config["if_ht"],
    log:
        raw_pairs_log = "processed/{sample}/2d_info/raw.pairs.log",
        contacts_pairs_log = "processed/{sample}/2d_info/contacts.pairs.log",

    shell:"""
        set -euo pipefail
        source {input.output_utils}

        if_ht={params.if_ht}
        input_records=$(charm_gzip_nonheader_records {input.contacts_seg})
        if (( input_records > 0 )); then
            {SCRIPTS_DIR}/hickit --dup-dist=0 -i {input.contacts_seg} -o - \
              2> {log.raw_pairs_log} | gzip > {output.raw_pairs}
            if [ "$if_ht" = "False" ]; then
                {SCRIPTS_DIR}/hickit --dup-dist=500 -i {input.contacts_seg} -o - \
                  2> {log.contacts_pairs_log} | gzip > {output.contacts_pairs}
            else
                {SCRIPTS_DIR}/hickit --dup-dist=1 -i {input.contacts_seg} -o - \
                  2> {log.contacts_pairs_log} | gzip > {output.contacts_pairs}
            fi
        else
            charm_make_empty_pairs_from_seg \
              {input.contacts_seg} {output.raw_pairs} gzip
            cp {output.raw_pairs} {output.contacts_pairs}
            printf 'biological_empty: no contact segments\n' > {log.raw_pairs_log}
            printf 'biological_empty: no contact segments\n' > {log.contacts_pairs_log}
        fi
    """

# Clean promiscuous legs, isolated contacts, and splicing contacts as separate
# targets so 2D-only runs can stop at c12.
rule clean_leg:
    input:
        contacts_pairs = rules.seg2pairs.output.contacts_pairs,
        output_utils = os.path.join(SCRIPTS_DIR, "output_utils.sh"),
    output:
        clean1_pairs = "result/cleaned_pairs/c1/{sample}.pairs.gz",
    threads: config["resources"]["hires_clean_cpu_threads"]
    shell:"""
        set -euo pipefail
        source {input.output_utils}
        export PYTHONPATH={CHARMTOOLS_PYTHONPATH}:${{PYTHONPATH:-}}

        input_records=$(charm_gzip_nonheader_records {input.contacts_pairs})
        if (( input_records > 0 )); then
            python -m CHARMtools clean_leg -t {threads} \
              {input.contacts_pairs} -o {output.clean1_pairs}
        else
            charm_copy_gzip_headers \
              {input.contacts_pairs} {output.clean1_pairs} gzip
        fi
    """

rule clean_isolated:
    input:
        clean1_pairs = rules.clean_leg.output.clean1_pairs,
        output_utils = os.path.join(SCRIPTS_DIR, "output_utils.sh"),
    output:
        clean12_pairs = "result/cleaned_pairs/c12/{sample}.pairs.gz",
    threads: config["resources"]["hires_clean_cpu_threads"]
    shell:"""
        set -euo pipefail
        source {input.output_utils}
        export PYTHONPATH={CHARMTOOLS_PYTHONPATH}:${{PYTHONPATH:-}}

        input_records=$(charm_gzip_nonheader_records {input.clean1_pairs})
        if (( input_records > 0 )); then
            python -m CHARMtools clean_isolated -t {threads} \
              -o {output.clean12_pairs} {input.clean1_pairs}
        else
            charm_copy_gzip_headers \
              {input.clean1_pairs} {output.clean12_pairs} gzip
        fi
    """

rule clean_splicing:
    input:
        clean12_pairs = rules.clean_isolated.output.clean12_pairs,
        output_utils = os.path.join(SCRIPTS_DIR, "output_utils.sh"),
    output:
        clean123_pairs = "result/cleaned_pairs/c123/{sample}.pairs.gz",
    threads: config["resources"]["hires_clean_cpu_threads"]
    params:
        ref_annotation = config["refs"][config["ref_genome"]]["annotations"],
    shell:"""
        set -euo pipefail
        source {input.output_utils}
        export PYTHONPATH={CHARMTOOLS_PYTHONPATH}:${{PYTHONPATH:-}}

        input_records=$(charm_gzip_nonheader_records {input.clean12_pairs})
        if (( input_records > 0 )); then
            python -m CHARMtools clean_splicing {input.clean12_pairs} \
              -r {params.ref_annotation} -o {output.clean123_pairs} -t {threads}
        else
            charm_copy_gzip_headers \
              {input.clean12_pairs} {output.clean123_pairs} gzip
        fi
    """


rule hickit_2d:
    input:
        cleaned_pairs = rules.clean_splicing.output.clean123_pairs,
        output_utils = os.path.join(SCRIPTS_DIR, "output_utils.sh"),
    output:
        impute_pairs = "result/impute/pairs/{sample}.impute.pairs.gz",
        impute_val = "result/impute/val/{sample}.impute.val",
    log:
        impute_pairs_log = "processed/{sample}/2d_info/{sample}.impute.pairs.log",
        impute_val_log = "processed/{sample}/2d_info/{sample}.impute.val.log",

    shell:"""
        set -euo pipefail
        source {input.output_utils}

        input_records=$(charm_gzip_nonheader_records {input.cleaned_pairs})
        if (( input_records > 0 )); then
            {SCRIPTS_DIR}/hickit -i {input.cleaned_pairs} -u -o - \
              2> {log.impute_pairs_log} | bgzip > {output.impute_pairs}
            {SCRIPTS_DIR}/hickit -i {input.cleaned_pairs} \
              --out-val={output.impute_val} 2> {log.impute_val_log}
            test -s {output.impute_val}
        else
            charm_copy_gzip_headers \
              {input.cleaned_pairs} {output.impute_pairs} bgzip
            : > {output.impute_val}
            printf 'biological_empty: no cleaned pairs\n' > {log.impute_pairs_log}
            printf 'biological_empty: no cleaned pairs\n' > {log.impute_val_log}
        fi
        """
