rule R2_mapping:
    input:
        ref_genome=config["refs"][config["ref_genome"]]["bwa_mem2_index"],
        R1 = rules.multiSplit.output.split_R1,
        R2 = rules.multiSplit.output.split_R2,
    output:
        sortbam = "processed/{sample}/{split}/{sample}.sort.bam"
    threads: config["resources"]["cuttag_bwa_threads"] + config["resources"]["cuttag_sort_threads"]
    params:
        bwa_threads = config["resources"]["cuttag_bwa_threads"],
        sort_threads = config["resources"]["cuttag_sort_threads"]
    shell:"""
        set -o pipefail
        bwa-mem2 mem -5SP -t{params.bwa_threads} {input.ref_genome} {input.R1} {input.R2} | samtools sort -@{params.sort_threads} -o {output.sortbam} - || \
        {{ echo "WARN: R2_mapping failed for {wildcards.sample}.{wildcards.split}, writing empty bam" >&2; : > {output.sortbam}; }}

    """

rule bam2bed:
    input:
        sortbam = rules.R2_mapping.output.sortbam,
        snp_file = config["refs"][config["ref_genome"]]["snp"]
    output:
        R2_bed = "processed/{sample}/{split}/{sample}.{split}.R2_5.bed.gz",
    threads: config["resources"]["cuttag_bam2bed_sort_threads"]
    shell:"""
        export PATH={SCRIPTS_DIR}:$PATH
        if [ ! -s {input.sortbam} ]; then
            : | gzip > {output.R2_bed}
        else
            set -o pipefail
            samtools view -h {input.sortbam} | samtools sort -n -@{threads} | samtools view - | {SCRIPTS_DIR}/hickit.js sam2seg -d 0 -v {input.snp_file} - | \
            python {SCRIPTS_DIR}/seg2bed.py - - | gzip > {output.R2_bed} || {{ : | gzip > {output.R2_bed}; }}
        fi

    """

rule generate_dedup_fragments:
    input:
        R2_bed = rules.bam2bed.output.R2_bed,
    output:
        fragments = "processed/{split}_all/{sample}.{split}.frag.bed.gz",
    log: "processed/{split}_all/{sample}.{split}.frag.log",
    shell:"""
        
        python {SCRIPTS_DIR}/dedup_bed.py -i {input.R2_bed} -o {output.fragments} -t normal > {log} || \
        {{ echo "WARN: generate_dedup_fragments failed for {wildcards.sample}.{wildcards.split}, writing empty fragments" >> {log}; : | gzip > {output.fragments}; }}

    """

rule foramt_fragmenets:
    input:
        fragments = rules.generate_dedup_fragments.output.fragments,
    output:
        format_fragments = "processed/{split}_all/{sample}.{split}.format_frag.bed.gz"
    shell:"""

        set -o pipefail
        zcat {input.fragments} | cut -f 1-3 | awk '{{OFS="\t"}}{{print $0"\t{wildcards.sample}\t1"}}' | gzip > {output.format_fragments} || \
        {{ : | gzip > {output.format_fragments}; }}
        
    """

rule combine_fragments:
    input:
        fragments = expand("processed/{{split}}_all/{sample}.{{split}}.format_frag.bed.gz", sample=SAMPLES),
    output:
        fragments = "result/fragments/{split}.fragments.bgz",
    threads: config["resources"]["cuttag_combine_bgzip_threads"]
    shell:"""

        zcat {input.fragments} | sort -k1,1 -k2,2n | uniq |  bgzip -@ {threads} > {output.fragments}
        tabix -p bed {output.fragments}

    """
