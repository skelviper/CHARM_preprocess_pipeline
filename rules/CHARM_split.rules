rule multiSplit:
    input:
        read1=lambda wildcards: contract_raw_read(wildcards.sample, "r1"),
        read2=lambda wildcards: contract_raw_read(wildcards.sample, "r2"),
        input_receipt=lambda wildcards: contract_sample_receipt(wildcards.sample),
        fanout=os.path.join(SCRIPTS_DIR, "fanout_cutadapt.py"),
    output:
        ct_R1="processed/{sample}/ct/{sample}.ct.R1.fq.gz",
        ct_R2="processed/{sample}/ct/{sample}.ct.R2.fq.gz",
        atac_R1="processed/{sample}/atac/{sample}.atac.R1.fq.gz",
        atac_R2="processed/{sample}/atac/{sample}.atac.R2.fq.gz",
    threads: 2 * config["resources"]["cutadapt_cpu_threads"] + 2
    params:
        ct_adapter=config["split"]["ct"],
        atac_adapter=config["split"]["atac"],
        cutadapt_threads=config["resources"]["cutadapt_cpu_threads"],
        seq_format=config.get("format", "illumina")
    shell:"""
        set -euo pipefail
        python {input.fanout} \
          --read1 {input.read1} \
          --read2 {input.read2} \
          --split ct '{params.ct_adapter}' {output.ct_R1} {output.ct_R2} \
          --split atac '{params.atac_adapter}' {output.atac_R1} {output.atac_R2} \
          --threads-per-split {params.cutadapt_threads} \
          --decompress-threads 1 \
          --seq-format {params.seq_format}
        """

rule split:
    input:
        read1=lambda wildcards: contract_raw_read(wildcards.sample, "r1"),
        read2=lambda wildcards: contract_raw_read(wildcards.sample, "r2"),
        input_receipt=lambda wildcards: contract_sample_receipt(wildcards.sample),
    output:
        DNA_R1="processed/{sample}/DNA/{sample}.dna.R1.fq.gz",
        DNA_R2="processed/{sample}/DNA/{sample}.dna.R2.fq.gz",
        RNA_R1="processed/{sample}/RNA/{sample}.rna.R1.fq.gz",
        RNA_R2="processed/{sample}/RNA/{sample}.rna.R2.fq.gz",
    threads: config["resources"]["cutadapt_cpu_threads"]
    params:
        adapter=r"XGGTTGAGGTAGTATTGCGCAATG;o=20",
        seq_format=config.get("format", "illumina")
    shell:"""
        if [ "{params.seq_format}" = "bgi" ]; then
            cutadapt -G '{params.adapter}' -j {threads} --untrimmed-output {output.DNA_R1}.tmp --untrimmed-paired-output {output.DNA_R2}.tmp -o {output.RNA_R1}.tmp -p {output.RNA_R2}.tmp {input.read1} {input.read2} && \
            awk '{{if(NR%4==1) gsub("/1"," 1",$1); print $0}}' {output.RNA_R1}.tmp | gzip > {output.RNA_R1} && \
            awk '{{if(NR%4==1) gsub("/2"," 2",$1); print $0}}' {output.RNA_R2}.tmp | gzip > {output.RNA_R2} && \
            awk '{{if(NR%4==1) gsub("/1"," 1",$1); print $0}}' {output.DNA_R1}.tmp | gzip > {output.DNA_R1} && \
            awk '{{if(NR%4==1) gsub("/2"," 2",$1); print $0}}' {output.DNA_R2}.tmp | gzip > {output.DNA_R2} && \
            rm {output.RNA_R1}.tmp {output.RNA_R2}.tmp {output.DNA_R1}.tmp {output.DNA_R2}.tmp
        else
            cutadapt -G '{params.adapter}' -j {threads} --untrimmed-output {output.DNA_R1} --untrimmed-paired-output {output.DNA_R2} -o {output.RNA_R1} -p {output.RNA_R2} {input.read1} {input.read2}
        fi
        """

# get rid of the ATAC/CT adaptors in the DNA data
rule cutRound2_DNA:
    input:
        DNA_R1="processed/{sample}/DNA/{sample}.dna.R1.fq.gz",
        DNA_R2="processed/{sample}/DNA/{sample}.dna.R2.fq.gz",
    output:
        trimmed_DNA_R1="processed/{sample}/DNA/{sample}.dna.clean.R1.fq.gz",
        trimmed_DNA_R2="processed/{sample}/DNA/{sample}.dna.clean.R2.fq.gz",
    threads: config["resources"]["cutadapt_cpu_threads"]
    params:
        adapters=lambda wildcards: " ".join([f"-G '{config['split'][key]}'" for key in config["split"]])
    shell:"""

        cutadapt {params.adapters} -j {threads} -o {output.trimmed_DNA_R1} -p {output.trimmed_DNA_R2} {input.DNA_R1} {input.DNA_R2}

        """

#cutRound2 is for minimize genome contamination in RNA data, probably from exonuclease activity of reverse transcriptase
rule cutRound2_RNA:
    input:
        RNA_R1="processed/{sample}/RNA/{sample}.rna.R1.fq.gz",
        RNA_R2="processed/{sample}/RNA/{sample}.rna.R2.fq.gz"
    output: 
        RNA_R1="processed/{sample}/RNA/{sample}.rna.clean.R1.fq.gz",
        RNA_R2="processed/{sample}/RNA/{sample}.rna.clean.R2.fq.gz",
    threads: config["resources"]["cutadapt_cpu_threads"]
    params:
        adapter=r"XNNNNNNNNTTTTTTTTTTTTTTT;o=18"
    shell:"""
        cutadapt --action=none --discard-untrimmed -G '{params.adapter}' -j {threads} -o {output.RNA_R1} -p {output.RNA_R2} {input.RNA_R1} {input.RNA_R2}
        """
